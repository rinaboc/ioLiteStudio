<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UIToolkit/UnityThemes/GeneralStyles.uss?fileID=7433441132597879392&amp;guid=2b43bc268b1dc5a4bb52996b43333856&amp;type=3#GeneralStyles"/>
    <ui:VisualElement name="Base" style="flex-grow: 1; flex-direction: row; background-color: rgb(192, 192, 192);">
        <ui:VisualElement name="Sidebar" style="flex-grow: 0.3; background-color: rgb(87, 87, 87); max-width: 30%;">
            <ui:VisualElement name="NodeInspector" style="flex-grow: 1;">
                <ui:VisualElement name="InspectorHeader" style="flex-grow: 0; background-color: rgb(77, 77, 77); padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; flex-direction: column;">
                    <ui:VisualElement name="InspectorTitle" style="flex-grow: 0; flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label text="Nodes" triple-click-selects-line="false" double-click-selects-word="false" class="text-small" style="color: rgb(204, 204, 204);"/>
                        <ui:Toggle label="" value="true" name="NodeInspectorToggle" style="width: 30px; height: 30px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="NodeCommands" style="flex-grow: 0; flex-direction: row; justify-content: flex-end; background-color: rgb(102, 102, 102);">
                        <ui:Button text="+" name="AddNodeBtn" class="icon-button-small"/>
                        <ui:Button text="x" name="DeleteNodeBtn" class="icon-button-small"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="NodeContainer" style="flex-grow: 1; padding-top: 0; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgb(77, 77, 77);">
                    <ui:VisualElement name="NodeList" style="flex-grow: 1; background-color: rgb(102, 102, 102);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ParameterInspector" style="flex-grow: 1;">
                <ui:VisualElement name="InspectorHeader" style="flex-grow: 0; background-color: rgb(77, 77, 77); padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; flex-direction: column;">
                    <ui:VisualElement name="InspectorTitle" style="flex-grow: 0; flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label text="Parameters" triple-click-selects-line="false" double-click-selects-word="false" class="text-small" style="color: rgb(204, 204, 204);"/>
                        <ui:Toggle label="" value="true" name="ParameterInspectorToggle" style="width: 30px; height: 30px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ParameterCommands" style="flex-grow: 0; flex-direction: row; justify-content: flex-end; background-color: rgb(102, 102, 102);">
                        <ui:Button text="+" name="AddParameterBtn" class="icon-button-small"/>
                        <ui:Button text="x" name="DeleteParameterBtn" class="icon-button-small"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ParameterContainer" style="flex-grow: 1; padding-top: 0; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgb(77, 77, 77);">
                    <ui:VisualElement name="ParameterList" style="flex-grow: 1; background-color: rgb(102, 102, 102);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Vertical" style="flex-grow: 1;">
            <ui:VisualElement name="TopBar" style="background-color: rgb(77, 77, 77); flex-direction: row;">
                <ui:VisualElement name="WorkspaceActions" style="flex-grow: 1; flex-direction: row;">
                    <ui:Button text="File" name="FileBtn"/>
                </ui:VisualElement>
                <ui:VisualElement name="UndoContainer" style="flex-direction: row; justify-content: flex-end; align-self: center;">
                    <ui:Button text="" name="UndoBtn" class="icon-button" style="background-image: url(&quot;project://database/Assets/Textures/Icons/undo.png?fileID=2800000&amp;guid=7805e25bba48a864e864ee9ce07fd489&amp;type=3#undo&quot;);"/>
                    <ui:Button text="" name="RedoBtn" class="icon-button" style="background-image: url(&quot;project://database/Assets/Textures/Icons/redo.png?fileID=2800000&amp;guid=61c128dd1e5182a45ae20c84b9c0cd86&amp;type=3#redo&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Viewport" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Textures/Viewport_Render_Texture.renderTexture?fileID=8400000&amp;guid=52d92df60afdb864b8cbbbe88f41053a&amp;type=2#Viewport_Render_Texture&quot;); -unity-background-scale-mode: scale-and-crop;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PopupWindowBase" class="hide" style="position: absolute; width: 100%; height: 100%; background-color: rgba(36, 32, 41, 0.376); align-items: center; justify-content: center;">
        <ui:VisualElement name="WindowContainer" style="width: 800px; background-color: rgb(212, 212, 212); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
            <ui:VisualElement name="WindowHeader" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Label" name="WindowTitle" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
