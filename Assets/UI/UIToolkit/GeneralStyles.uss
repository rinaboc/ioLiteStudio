:root {
}

.icon-button {
    flex-grow: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    font-size: 24px;
    flex-shrink: 0;
    -unity-text-auto-size: none;
    width: 100px;
    height: 100px;
    background-size: 70% 70%;
    -unity-background-image-tint-color: rgb(229, 229, 229);
    background-color: rgb(178, 178, 178);
}
