:root {
    font-size: 32px;
    -unity-text-auto-size: best-fit 24px 32px;
    transition-property: flex-grow;
    transition-timing-function: ease-in-out;
    transition-duration: 1s;
}

.icon-button {
    flex-grow: 0;
    flex-shrink: 0;
    -unity-text-auto-size: none;
    width: 100px;
    height: 100px;
    background-size: 70% 70%;
    -unity-background-image-tint-color: rgb(128, 128, 128);
}

Button {
    min-width: 100px;
    min-height: 100px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.hide {
    display: none;
}

.panel {
    flex-grow: 1;
}

.text-small {
    font-size: 26px;
    -unity-text-auto-size: best-fit 24px 26px;
}

.icon-button-small {
    flex-grow: 0;
    flex-shrink: 0;
    background-size: 70% 70%;
    -unity-background-image-tint-color: rgb(102, 102, 102);
    width: 76px;
    height: 76px;
    min-width: 76px;
    min-height: 76px;
}



#choicesContentContainer {
    flex-direction: row;
    justify-content: space-around;
}








