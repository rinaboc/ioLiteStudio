<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UIToolkit/UnityThemes/GeneralStyles.uss?fileID=7433441132597879392&amp;guid=2b43bc268b1dc5a4bb52996b43333856&amp;type=3#GeneralStyles"/>
    <ui:VisualElement name="Inspector" style="flex-grow: 1;">
        <ui:VisualElement name="InspectorHeader" style="flex-grow: 0; background-color: rgb(77, 77, 77); padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; flex-direction: column;">
            <ui:VisualElement name="InspectorTitle" style="flex-grow: 0; flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="Title" triple-click-selects-line="false" double-click-selects-word="false" name="InspectorTitleLabel" class="text-small" style="color: rgb(204, 204, 204);"/>
                <ui:Toggle label="" value="true" name="InspectorToggle" class="iolite-toggle" style="width: 30px; height: 30px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="InspectorCommands" style="flex-direction: row; justify-content: flex-end; background-color: rgb(102, 102, 102); overflow: hidden;">
                <ui:Button text="" name="AddBtn" class="icon-button-small" style="background-image: url(&quot;project://database/Assets/Textures/Icons/plus.png?fileID=2800000&amp;guid=3a250705a68412348acda7a3afeca8c1&amp;type=3#plus&quot;); overflow: hidden;"/>
                <ui:Button text="" name="DeleteBtn" class="icon-button-small" style="background-image: url(&quot;project://database/Assets/Textures/Icons/trash.png?fileID=2800000&amp;guid=b716ebb3ff112474e9b98dd8b6511ba5&amp;type=3#trash&quot;); background-size: 80% 80%; overflow: hidden;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Container" style="padding-top: 0; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgb(77, 77, 77); flex-grow: 1;">
            <ui:VisualElement name="List" style="background-color: rgb(102, 102, 102); flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
